{
  "name": "TexturePipeline",
  "shader": "Texture",
  "inputAssembly": {
    "topology": "TriangleList"
  },
  "viewport": {
    "viewportCount": 1,
    "scissorCount": 1
  },
  "rasterization": {
    "polygonMode": "Fill",
    "cullMode": "None",
    "frontFace": "CounterClockwise"
  },
  "depthStencil": {
    "depthTest": true,
    "depthWrite": true,
    "depthCompare": "Less"
  },
  "colorBlend": {
    "attachments": [
      {
        "blendEnable": true,
        "srcColorBlend": "SrcAlpha",
        "dstColorBlend": "OneMinusSrcAlpha",
        "colorBlendOp": "Add",
        "srcAlphaBlend": "One",
        "dstAlphaBlend": "Zero",
        "alphaBlendOp": "Add",
        "colorWriteMask": ["R", "G", "B", "A"]
      }
    ]
  },
  "dynamicStates": ["Viewport", "Scissor"]
}
